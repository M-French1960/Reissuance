APP_NAME=PHOENIX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Cle HMAC de l'index aveugle sur le numero de piece (docs/DATA_MODEL.md §3).
# Distincte de APP_KEY. A sauvegarder : sa perte rend la recherche par numero
# impossible. Generer avec : php artisan phoenix:generate-index-key
PHOENIX_BLIND_INDEX_KEY=

LOG_CHANNEL=daily
LOG_LEVEL=debug

# PostgreSQL local (docs/ARCHITECTURE_LOCAL.md).
# L'application utilise phoenix_app, qui n'a PAS le droit de modifier ni de
# supprimer une ligne d'audit. Les migrations utilisent phoenix_owner.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=phoenix
DB_USERNAME=phoenix_app
DB_PASSWORD=
DB_OWNER_USERNAME=phoenix_owner
DB_OWNER_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database

# Disque prive : hors de public/, jamais servi directement (D-011).
FILESYSTEM_DISK=private

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="ne-pas-repondre@phoenix.test"
MAIL_FROM_NAME="${APP_NAME}"

# Adaptateurs d'integration : fake | real (docs/INTEGRATIONS.md)
PHOENIX_IDENTITY_PROVIDER=fake
PHOENIX_REGISTRY_PROVIDER=fake
PHOENIX_SIGNATURE_PROVIDER=fake

# --- Encaissement -----------------------------------------------------------
# TANT QUE LE TARIF N'EST PAS CONFIRME, NE PAS ACTIVER (docs/INTEGRATIONS.md 5).
# gate : none | before_submission | before_signature
PHOENIX_PAYMENT_GATE=none
# Montant en unite mineure, entier. Aucun defaut : un tarif se lit dans un
# texte reglementaire, il ne se devine pas. Le franc CFA n'a pas de
# subdivision, donc 1 000 F s'ecrit 1000.
PHOENIX_PAYMENT_AMOUNT_MINOR=
PHOENIX_PAYMENT_CURRENCY=XAF
PHOENIX_PAYMENT_MINOR_UNIT=0
# Reference du texte fixant le tarif. Vide tant qu'elle n'est pas verifiable.
PHOENIX_PAYMENT_LEGAL_BASIS=
PHOENIX_PAYMENT_PROVIDER=fake
