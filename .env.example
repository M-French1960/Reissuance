APP_NAME=PHOENIX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Cle HMAC de l'index aveugle sur le numero de piece (docs/DATA_MODEL.md §3).
# Distincte de APP_KEY. A sauvegarder : sa perte rend la recherche par numero
# impossible. Generer avec : php artisan phoenix:generate-index-key
PHOENIX_BLIND_INDEX_KEY=

LOG_CHANNEL=daily
LOG_LEVEL=debug

# MySQL local (docs/ARCHITECTURE_LOCAL.md).
#
# DB_CONNECTION n'accepte que « mysql » ou « mysql_owner ». Toute autre valeur
# fait REFUSER le demarrage : les barrieres anti-fraude sont posees dans la
# base (declencheurs, contraintes CHECK, journal en ajout seul) et ne survivent
# a aucun autre moteur. Sur SQLite, l'application fonctionnerait en apparence
# et accepterait une transition interdite sans rien signaler (D-054).
#
# L'application utilise phoenix_app, qui n'a PAS le droit de modifier ni de
# supprimer une ligne d'audit. Les migrations utilisent phoenix_owner.
# DB_SOCKET : laisser vide pour une connexion TCP ; renseigner le chemin de la
# socket unix si le serveur est local (ex. /var/run/mysqld/mysqld.sock).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET=
DB_DATABASE=phoenix
DB_USERNAME=phoenix_app
DB_PASSWORD=
DB_OWNER_USERNAME=phoenix_owner
DB_OWNER_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database

# Disque prive : hors de public/, jamais servi directement (D-011).
FILESYSTEM_DISK=private

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS="ne-pas-repondre@phoenix.test"
MAIL_FROM_NAME="${APP_NAME}"

# Adaptateurs d'integration : fake | real (docs/INTEGRATIONS.md)
PHOENIX_IDENTITY_PROVIDER=fake
PHOENIX_REGISTRY_PROVIDER=fake
PHOENIX_SIGNATURE_PROVIDER=fake

# --- Signature par appareil (WebAuthn) --------------------------------------
# Domaine des appareils de signature. Vide : deduit de APP_URL. A renseigner si
# l'application est servie sous plusieurs noms — une clef enrolee sous un
# domaine ne vaut pas sous un autre, et c'est ce qui la rend resistante a
# l'hameconnage.
#
# WebAuthn EXIGE UN CONTEXTE SECURISE : TLS, ou localhost. Sans TLS, la
# signature par appareil est indisponible et le code d'authentification reste
# le seul moyen de signer. Voir D-070.
PHOENIX_WEBAUTHN_RP_ID=

# --- Signature electronique (Docusign) --------------------------------------
# NE PAS ACTIVER. PHOENIX_SIGNATURE_PROVIDER=real fait echouer la signature
# avec un message explicite : le contrat de signature de PHOENIX est
# synchrone, Docusign signe de facon asynchrone, et la valeur juridique d'un
# acte d'etat civil signe electroniquement au Cameroun reste inconnue
# (question A1 de docs/COMPLIANCE_OPEN_QUESTIONS.md). Voir D-066.
#
# Ces reglages servent au client Docusign, qui lui est construit et teste.
# account-d.docusign.com = bac a sable ; account.docusign.com = production.
PHOENIX_DOCUSIGN_OAUTH_BASE=account-d.docusign.com
PHOENIX_DOCUSIGN_INTEGRATION_KEY=
PHOENIX_DOCUSIGN_USER_ID=
# Chemin du fichier de cle privee RSA, HORS du depot. Une cle rangee dans
# l'arborescence du projet est refusee : elle autorise a signer des actes.
PHOENIX_DOCUSIGN_PRIVATE_KEY=
# Vide = compte par defaut de l'utilisateur impersonne.
PHOENIX_DOCUSIGN_ACCOUNT_ID=
# Sceau electronique (seal_name), a provisionner sur le compte Docusign.
PHOENIX_DOCUSIGN_SEAL_NAME=
PHOENIX_DOCUSIGN_TIMEOUT=30

# --- Encaissement -----------------------------------------------------------
# TANT QUE LE TARIF N'EST PAS CONFIRME, NE PAS ACTIVER (docs/INTEGRATIONS.md 5).
# gate : none | before_submission | before_signature
PHOENIX_PAYMENT_GATE=none
# Montant en unite mineure, entier. Aucun defaut : un tarif se lit dans un
# texte reglementaire, il ne se devine pas. Le franc CFA n'a pas de
# subdivision, donc 1 000 F s'ecrit 1000.
PHOENIX_PAYMENT_AMOUNT_MINOR=
PHOENIX_PAYMENT_CURRENCY=XAF
PHOENIX_PAYMENT_MINOR_UNIT=0
# Reference du texte fixant le tarif. Vide tant qu'elle n'est pas verifiable.
PHOENIX_PAYMENT_LEGAL_BASIS=
PHOENIX_PAYMENT_PROVIDER=fake

# --- HR-Skills Pay (agregateur mobile money) --------------------------------
# Contrat releve dans la documentation publiee par le prestataire. Aucun appel
# n'a ete fait contre le service reel : sans identifiants, l'adaptateur n'est
# verifie que contre un serveur simule (D-050).
# Basculer PHOENIX_PAYMENT_PROVIDER=real pour l'activer.
PHOENIX_HRSKILLS_BASE_URL=https://api.hrskills-pay.com
PHOENIX_HRSKILLS_SANDBOX=true
PHOENIX_HRSKILLS_PUBLIC_KEY=
PHOENIX_HRSKILLS_SECRET_KEY=
PHOENIX_HRSKILLS_WEBHOOK_SECRET=
PHOENIX_HRSKILLS_TIMEOUT=20
